# AWS Configuration
# Copy this file to .env and fill in your actual credentials

# AWS Region (use us-west-2 or your preferred region)
AWS_DEFAULT_REGION=us-west-2

# AWS Access Credentials
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Session Token (Optional - only for temporary credentials)
# Leave empty if using permanent credentials
AWS_SESSION_TOKEN=

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual AWS credentials
# 3. Never commit .env to version control (it's in .gitignore)
# 4. Ensure your AWS account has Bedrock access enabled
# 5. Required Bedrock models:
#    - anthropic.claude-3-5-sonnet-20240620-v1:0
#    - amazon.titan-embed-text-v2:0
#    - amazon.rerank-v1:0

# How to get AWS credentials:
# 1. Go to AWS Console (https://console.aws.amazon.com)
# 2. Navigate to IAM > Users
# 3. Create a new user or select existing user
# 4. Create access key
# 5. Copy Access Key ID and Secret Access Key
# 6. Paste them above

# Required IAM Permissions:
# - bedrock:InvokeModel
# - bedrock:InvokeModelWithResponseStream
# - bedrock:ListFoundationModels

# Security Best Practices:
# - Use IAM roles instead of access keys when possible
# - Rotate credentials regularly
# - Use least privilege principle
# - Enable MFA on your AWS account
# - Never share or commit credentials
